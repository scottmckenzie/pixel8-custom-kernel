# Droidspaces kernel requirements: options it treats as fatal if missing.
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_SYSVIPC=y
CONFIG_CGROUP_DEVICE=y
CONFIG_DEVTMPFS=y
CONFIG_SECCOMP=y
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_USER_NS=y

# Optional Droidspaces features (macvlan networking, IPv6 NAT, CPU and PID limits).
CONFIG_MACVLAN=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
