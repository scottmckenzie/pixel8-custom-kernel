# Starter fragment: the options Droidspaces treats as fatal if missing.
# Replace/extend this with the full GKI fragment from Droidspaces'
# Documentation/Kernel-Configuration.md (or the app's Settings -> Requirements).
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_SYSVIPC=y
CONFIG_CGROUP_DEVICE=y
CONFIG_DEVTMPFS=y
CONFIG_SECCOMP=y
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
